<android.support.design.widget.CoordinatorLayout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/myCoordinatorLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent" android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:orientation="vertical"
    tools:context="net.simplifiedcoding.sqlitedbcode.ViewPeople"
    android:weightSum="1">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Refrence"
        android:id="@+id/refrence" />

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:enabled="false"

        android:id="@+id/editref" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Plot/Street"
        android:id="@+id/PS" />

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:enabled="false"
        android:id="@+id/editPS" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Meter #"
        android:id="@+id/meternum" />

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:enabled="false"
        android:id="@+id/editmeter" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Previous"
        android:id="@+id/previous" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:weightSum="1">

        <EditText
            android:id="@+id/editprevious"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="0.33"
            android:enabled="false"
            android:hint="Current"
            android:inputType="number"
            android:paddingRight="25dp" />

        <EditText
            android:id="@+id/previouspeak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="0.33"
            android:enabled="false"
            android:inputType="number"
            android:paddingRight="25dp" />

        <EditText
            android:id="@+id/previousoffpeak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="0.33"
            android:enabled="false"
            android:inputType="number"
            android:paddingRight="25dp" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Present"
        android:id="@+id/present" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:weightSum="1">

        <EditText
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:enabled="true"
            android:hint="Total Reading"
            android:layout_weight="0.50"
            android:paddingRight="25dp"
            android:inputType="number"
            android:id="@+id/editpresent" />

        <EditText
            android:id="@+id/editpeak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="0.25"
            android:enabled="true"
            android:hint="New Peak"
            android:inputType="number"
            android:paddingRight="25dp" />

        <EditText
            android:id="@+id/editoffpeak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="0.25"
            android:enabled="true"
            android:hint="New Off Peak"
            android:inputType="number"
            android:paddingRight="25dp" />

    </LinearLayout>

        <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:enabled="false"
        android:visibility="gone"
        android:id="@+id/editID" />

    <!--    ///// Radio Group -->

    <RadioGroup
        android:id="@+id/radioGroup1"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal" >
        <RadioButton
            android:id="@+id/radio0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="RG" />

        <RadioButton
            android:id="@+id/radio1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PD" />

        <RadioButton
            android:id="@+id/radio2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DF" />

        <RadioButton
            android:id="@+id/radio3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LK" />

        <RadioButton
            android:id="@+id/radio4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RP" />
    </RadioGroup>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:weightSum="1">

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Previous"
            android:onClick="movePrev"
            android:id="@+id/btnPrev"
            android:layout_weight="0.20" />
        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save"
            android:id="@+id/btnSave"
            android:layout_weight="0.30" />

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Next"
            android:id="@+id/btnNext"
            android:onClick="moveNext"
            android:layout_weight="0.50" />
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:weightSum="1">

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Peak Pics"
            android:id="@+id/btnpeak"
            android:layout_weight="0.50" />

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OFFPeak Pics"
            android:id="@+id/btnoffpeak"
            android:layout_weight="0.50" />
    </LinearLayout>

    <Button
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:text="Full Picture"
        android:onClick="PicsTake"
        android:id="@+id/btnCapture" />

    <EditText
        android:layout_width="66dp"
        android:id="@+id/editadvance"
        android:layout_height="wrap_content"
        android:enabled="false"
        android:fontFamily="sans-serif-light"
        android:layout_centerHorizontal="true"
        android:paddingTop="10dp"
        android:textColor="#AD9A3E"
        android:layout_gravity="right"
        android:gravity="bottom" />

    <EditText
        android:layout_width="wrap_content"
        android:id="@+id/edittariff"
        android:layout_height="wrap_content"
        android:enabled="false"
        android:fontFamily="Calibri"
        android:paddingTop="08dp"
        android:layout_alignParentBottom ="true"
        android:textColor="#ff0000"
        android:layout_gravity="left"
        android:gravity="bottom" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

</LinearLayout>
</android.support.design.widget.CoordinatorLayout>