<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="20dp"
    android:gravity="top|center"
    tools:context="net.simplifiedcoding.sqlitedbcode.ViewPeople">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="16dp"
        android:text="Status Calculation"
        android:layout_gravity="left"
        android:paddingBottom="2dp"
        android:paddingLeft="10dp"
        android:textColor="#AD8A2E"
        android:id="@+id/statuscalc" />

    <View
        android:layout_width="330dp"
        android:layout_height="0.5dp"
        android:background="#B3B3B3"
        android:padding="10dp"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="16dp"
        android:paddingBottom="4dp"
        android:id="@+id/totalconnection" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="16dp"
        android:paddingBottom="4dp"
        android:id="@+id/pd" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="16dp"
        android:paddingBottom="4dp"
        android:id="@+id/df" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="16dp"
        android:paddingBottom="4dp"
        android:id="@+id/lk" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="16dp"
        android:paddingBottom="4dp"
        android:id="@+id/rp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="16dp"
        android:text="Reading Caclulation"
        android:layout_gravity="left"
        android:paddingBottom="2dp"
        android:paddingTop="10dp"
        android:paddingLeft="10dp"
        android:textColor="#AD8A2E"
        android:id="@+id/readingcalc" />

    <View
        android:layout_width="330dp"
        android:layout_height="0.5dp"
        android:background="#B3B3B3"
        android:padding="10dp"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="16dp"
        android:paddingBottom="4dp"
        android:id="@+id/previousreading" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="16dp"
        android:paddingBottom="4dp"
        android:id="@+id/presentreading" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="16dp"
        android:paddingBottom="4dp"
        android:id="@+id/advance" />

</LinearLayout>
