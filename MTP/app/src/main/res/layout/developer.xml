<GridLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:columnCount="16"
    android:orientation="horizontal"
    android:rowCount="28"
    android:layout_marginLeft="10dp"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <TextView
        android:layout_columnSpan="1"
        android:layout_rowSpan="28"
        android:textAlignment="center"
        android:paddingTop="10dp"
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="#000"
        android:drawableTop="@drawable/thumbnail"
        android:text="AHSAN UL HAQ" />

    <TextView
        android:layout_columnSpan="11"
        android:layout_row="2"
        android:paddingLeft="10dp"
        android:paddingTop="10dp"
        android:id="@+id/phone"
        android:layout_height="wrap_content"
        android:text="Phone"
        android:textStyle="bold"
        android:textColor="#000"
        android:textSize="18dp"
        android:layout_centerHorizontal="true" />

    <View
        android:layout_width="match_parent"
        android:paddingTop="2dp"
        android:layout_height="1dp"
        android:layout_row="3"
        android:layout_columnSpan="11"
        android:background="@android:color/darker_gray"/>

    <TextView
        android:layout_columnSpan="11"
        android:layout_row="4"
        android:paddingTop="10dp"
        android:paddingLeft="10dp"
        android:id="@+id/phonenumber"
        android:layout_height="wrap_content"
        android:text="+92-313-5103076\n+92-51-5733277"
        android:textColor="#000"
        android:textSize="18dp"
        android:layout_centerHorizontal="true" />

    <!--   Email List -->

    <TextView
        android:layout_columnSpan="11"
        android:layout_row="5"
        android:paddingLeft="10dp"
        android:paddingTop="10dp"
        android:id="@+id/email"
        android:layout_height="wrap_content"
        android:text="Email"
        android:textStyle="bold"
        android:textColor="#000"
        android:textSize="18dp"
        android:layout_centerHorizontal="true" />

    <View
        android:layout_width="match_parent"
        android:paddingTop="2dp"
        android:layout_height="1dp"
        android:layout_row="6"
        android:layout_columnSpan="11"
        android:background="@android:color/darker_gray"/>

    <TextView
        android:layout_columnSpan="11"
        android:layout_row="7"
        android:paddingTop="10dp"
        android:paddingLeft="10dp"
        android:id="@+id/phonenumbers"
        android:layout_height="wrap_content"
        android:text="rajaahsanulhaq3@gmail\n.com"
        android:textColor="#000"
        android:textSize="18dp"
        android:layout_centerHorizontal="true" />

    <!--   Profession List -->
    <TextView
        android:layout_columnSpan="11"
        android:layout_row="8"
        android:paddingLeft="10dp"
        android:paddingTop="10dp"
        android:id="@+id/profession"
        android:layout_height="wrap_content"
        android:text="Profession"
        android:textStyle="bold"
        android:textColor="#000"
        android:textSize="18dp"
        android:layout_centerHorizontal="true" />

    <View
        android:layout_width="match_parent"
        android:paddingTop="2dp"
        android:layout_height="1dp"
        android:layout_row="9"
        android:layout_columnSpan="11"
        android:background="@android:color/darker_gray"/>

    <TextView
        android:layout_columnSpan="11"
        android:layout_row="10"
        android:paddingTop="10dp"
        android:paddingLeft="10dp"
        android:id="@+id/proflist"
        android:layout_height="wrap_content"
        android:text="Software Developer"
        android:textColor="#000"
        android:textSize="18dp"
        android:layout_centerHorizontal="true" />

    <!--   Experties List -->
    <TextView
        android:layout_columnSpan="11"
        android:layout_row="11"
        android:paddingLeft="10dp"
        android:paddingTop="10dp"
        android:id="@+id/experties"
        android:layout_height="wrap_content"
        android:text="Experties"
        android:textStyle="bold"
        android:textColor="#000"
        android:textSize="18dp"
        android:layout_centerHorizontal="true" />

    <View
        android:layout_width="match_parent"
        android:paddingTop="2dp"
        android:layout_height="1dp"
        android:layout_row="12"
        android:layout_columnSpan="11"
        android:background="@android:color/darker_gray"/>

    <TextView
        android:layout_columnSpan="11"
        android:layout_row="13"
        android:paddingTop="10dp"
        android:paddingLeft="10dp"
        android:id="@+id/exprlist"
        android:layout_height="wrap_content"
        android:text="IBM Lotus Notes,Android\n,Quality Analyst ,Web\n Developer "
        android:textColor="#000"
        android:textSize="18dp"
        android:layout_centerHorizontal="true" />


</GridLayout>